{% assign hero_product = all_products['travelnivo-8-piece-packing-cube-set'] %}
{% assign hero_url = '/collections/travel-essentials' %}
{% assign hero_title = 'TravelNivo 8-Piece Packing Cube Set' %}
{% assign hero_price = '$34.99' %}
{% if hero_product != blank %}
  {% assign hero_url = hero_product.url %}
  {% assign hero_title = hero_product.title %}
  {% capture hero_price %}{{ hero_product.price | money }}{% endcapture %}
{% endif %}

<section class="tn-hero">
  <div class="tn-hero__inner">
    <div class="tn-hero__copy">
      <p class="tn-eyebrow">TRAVELNIVO</p>
      <h1>Pack smarter.<br>Travel lighter.</h1>
      <p class="tn-hero__lead">Simple organizers that keep your suitcase neat, your essentials easy to find, and every trip easier to manage.</p>
      <div class="tn-hero__actions">
        <a class="tn-button tn-button--primary" href="/collections/travel-essentials">Shop travel essentials</a>
        <a class="tn-button tn-button--quiet" href="/pages/about">Why TravelNivo</a>
      </div>
      <div class="tn-hero__micro" aria-label="TravelNivo values">
        <span>Organize</span><i aria-hidden="true"></i><span>Pack</span><i aria-hidden="true"></i><span>Go</span>
      </div>
    </div>

    <div class="tn-hero__visual">
      <a class="tn-hero__image-link" href="{{ hero_url }}" aria-label="{{ hero_title | escape }}">
        <img
          src="https://cdn.shopify.com/s/files/1/0816/4609/2515/files/7a103773-12bf-4bc5-8b8d-505a5532d23e.jpg?v=1787745562"
          alt="TravelNivo packing cube organizer set"
          width="1200"
          height="1200"
          loading="eager"
          fetchpriority="high"
        >
      </a>
      <a class="tn-hero__product-card" href="{{ hero_url }}">
        <span>{{ hero_title }}</span>
        <strong>{{ hero_price }}</strong>
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
  .tn-hero {
    background: #f8f3eb;
    color: #17383a;
    padding: clamp(28px, 5vw, 72px) 20px;
  }
  .tn-hero__inner {
    width: min(1180px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(30px, 6vw, 84px);
    align-items: center;
  }
  .tn-eyebrow {
    margin: 0 0 16px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
  }
  .tn-hero h1 {
    margin: 0;
    max-width: 720px;
    font-size: clamp(3rem, 6.6vw, 6.8rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .tn-hero__lead {
    max-width: 590px;
    margin: 28px 0 0;
    font-size: clamp(1rem, 1.5vw, 1.22rem);
    line-height: 1.65;
    color: #355355;
  }
  .tn-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .tn-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    font-weight: 650;
    text-decoration: none;
    transition: transform 160ms ease, opacity 160ms ease;
  }
  .tn-button:hover { transform: translateY(-1px); }
  .tn-button--primary { background: #17383a; color: #fffdf8; }
  .tn-button--quiet { border: 1px solid #b9aaa0; color: #17383a; background: rgba(255,255,255,.3); }
  .tn-hero__micro {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    color: #6a726e;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: .08em;
  }
  .tn-hero__micro i { width: 4px; height: 4px; border-radius: 50%; background: currentColor; }
  .tn-hero__visual {
    position: relative;
    min-width: 0;
    background: #e9ded0;
    border-radius: 32px;
    padding: clamp(14px, 2vw, 24px);
    overflow: hidden;
  }
  .tn-hero__image-link { display: block; border-radius: 22px; overflow: hidden; background: #fff; }
  .tn-hero__image-link img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .tn-hero__product-card {
    position: absolute;
    right: clamp(22px, 4vw, 44px);
    bottom: clamp(22px, 4vw, 44px);
    left: clamp(22px, 4vw, 44px);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
    padding: 14px 16px;
    color: #17383a;
    background: rgba(255, 253, 248, .92);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    text-decoration: none;
    box-shadow: 0 12px 32px rgba(23, 56, 58, .12);
  }
  .tn-hero__product-card span { font-size: .9rem; line-height: 1.3; }
  .tn-hero__product-card strong { white-space: nowrap; }
  @media (max-width: 850px) {
    .tn-hero__inner { grid-template-columns: 1fr; }
    .tn-hero h1 { font-size: clamp(3.1rem, 14vw, 5.4rem); }
    .tn-hero__visual { order: 2; }
  }
  @media (max-width: 520px) {
    .tn-hero { padding-inline: 14px; }
    .tn-hero__actions { display: grid; }
    .tn-button { width: 100%; }
    .tn-hero__product-card { font-size: .86rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "TravelNivo hero",
  "settings": [],
  "presets": [{"name": "TravelNivo hero"}]
}
{% endschema %}