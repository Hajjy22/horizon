{% assign featured_handles = 'travelnivo-8-piece-packing-cube-set|travelnivo-cloud-travel-organizer|travelnivo-3-layer-tech-organizer|travelnivo-passport-cover' | split: '|' %}

<section class="tn-featured" data-tn-section>
  <div class="tn-featured__inner">
    <div class="tn-featured__header" data-tn-reveal>
      <div>
        <p class="tn-featured__eyebrow">TRAVEL ESSENTIALS / 02</p>
        <h2>Build your <em>calmer</em> carry-on.</h2>
      </div>
      <a class="tn-featured__view-all" href="/collections/travel-essentials">Shop all <span aria-hidden="true">↗</span></a>
    </div>

    <div class="tn-featured__grid">
      {% for handle in featured_handles %}
        {% assign product = all_products[handle] %}
        {% if product != blank %}
          <article class="tn-product" data-tn-reveal style="--tn-delay: {{ forloop.index0 | times: 70 }}ms;">
            <a class="tn-product__image" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
              {% if product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url: width: 1100 }}" alt="{{ product.title | escape }}" width="1100" height="1100" loading="lazy">
              {% endif %}
              <span class="tn-product__index">0{{ forloop.index }}</span>
              {% if product.has_only_default_variant %}<span class="tn-product__tag">Quick add</span>{% endif %}
            </a>
            <div class="tn-product__meta">
              <div class="tn-product__copy">
                <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
                <p>{{ product.description | strip_html | truncate: 92 }}</p>
              </div>
              <strong>{{ product.price | money }}</strong>
            </div>
            {% if product.has_only_default_variant and product.selected_or_first_available_variant.available %}
              <form action="{{ routes.cart_add_url }}" method="post" class="tn-product__form" data-tn-quick-add>
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button class="tn-product__quick-add" type="submit" data-tn-quick-add-button>
                  <span>Add to bag</span><span aria-hidden="true">+</span>
                </button>
              </form>
            {% else %}
              <a class="tn-product__options" href="{{ product.url }}">View options <span aria-hidden="true">→</span></a>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .tn-featured { background: #fffdf8; color: #17383a; padding: clamp(70px, 9vw, 126px) 20px; }
  .tn-featured__inner { width: min(1240px, 100%); margin: 0 auto; }
  .tn-featured__header { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 40px; }
  .tn-featured__eyebrow { margin: 0 0 10px; color: #e48a52; font-size: .7rem; font-weight: 800; letter-spacing: .2em; }
  .tn-featured h2 { margin: 0; max-width: 720px; font-size: clamp(2.6rem, 5vw, 5.8rem); line-height: .92; letter-spacing: -.06em; }
  .tn-featured h2 em { color: #e48a52; font-style: normal; }
  .tn-featured__view-all { display: inline-flex; align-items: center; gap: 8px; color: #17383a; font-weight: 700; white-space: nowrap; text-underline-offset: 5px; }
  .tn-featured__view-all span { transition: transform 160ms ease; }
  .tn-featured__view-all:hover span { transform: translate(2px,-2px); }
  .tn-featured__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(18px, 2.4vw, 30px); }
  .tn-product { min-width: 0; }
  .tn-product__image { position: relative; display: block; overflow: hidden; border-radius: 22px 22px 22px 5px; background: #eee5db; }
  .tn-product__image img { display: block; width: 100%; aspect-ratio: .9 / 1; object-fit: cover; transition: transform 420ms cubic-bezier(.2,.7,.2,1); }
  .tn-product__image:hover img { transform: scale(1.04); }
  .tn-product__index, .tn-product__tag { position: absolute; top: 12px; display: inline-flex; align-items: center; min-height: 26px; padding: 0 9px; border-radius: 999px; background: rgba(255,253,248,.9); color: #17383a; font-size: .62rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .tn-product__index { left: 12px; }
  .tn-product__tag { right: 12px; color: #e48a52; }
  .tn-product__meta { display: flex; align-items: start; justify-content: space-between; gap: 10px; padding: 16px 2px 0; }
  .tn-product__copy { min-width: 0; }
  .tn-product__meta h3 { margin: 0; font-size: 1rem; line-height: 1.2; }
  .tn-product__meta h3 a { color: inherit; text-decoration: none; }
  .tn-product__meta h3 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .tn-product__meta p { margin: 8px 0 0; color: #607071; font-size: .85rem; line-height: 1.5; }
  .tn-product__meta strong { white-space: nowrap; font-size: .95rem; }
  .tn-product__form { margin-top: 15px; }
  .tn-product__quick-add { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 44px; padding: 0 13px; border: 1px solid #bfd0cb; border-radius: 12px; background: transparent; color: #17383a; cursor: pointer; font: inherit; font-size: .78rem; font-weight: 800; transition: background-color 160ms ease, color 160ms ease, transform 160ms ease; }
  .tn-product__quick-add:hover { background: #17383a; color: #fffdf8; transform: translateY(-1px); }
  .tn-product__quick-add span:last-child { color: #e48a52; font-size: 1.1rem; }
  .tn-product__options { display: inline-flex; gap: 8px; align-items: center; margin-top: 15px; color: #17383a; font-size: .78rem; font-weight: 800; text-underline-offset: 4px; }
  .tn-product__options span { transition: transform 160ms ease; }
  .tn-product__options:hover span { transform: translateX(3px); }
  @media (max-width: 980px) { .tn-featured__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 44px; } }
  @media (max-width: 680px) { .tn-featured { padding-inline: 14px; } .tn-featured__header { align-items: start; } .tn-featured__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 12px; } .tn-product__meta { display: block; } .tn-product__meta strong { display: block; margin-top: 8px; } }
{% endstylesheet %}

{% schema %}
{"name":"TravelNivo featured","settings":[],"presets":[{"name":"TravelNivo featured"}]}
{% endschema %}