{% assign featured_handles = 'travelnivo-8-piece-packing-cube-set|travelnivo-cloud-travel-organizer|travelnivo-3-layer-tech-organizer|travelnivo-passport-cover' | split: '|' %}

<section class="tn-featured tn-rotator" data-tn-section data-tn-rotator>
  <div class="tn-featured__inner">
    <div class="tn-featured__header" data-tn-reveal>
      <div>
        <p class="tn-featured__eyebrow">TRAVEL ESSENTIALS / 02</p>
        <h2>Travel tools that <em>earn their space.</em></h2>
        <p class="tn-featured__subhead">Turn through the pieces that make every carry-on calmer. Choose one, then add it in a tap.</p>
      </div>
      <a class="tn-featured__view-all" href="/collections/travel-essentials">Shop all <span aria-hidden="true">↗</span></a>
    </div>

    <div class="tn-rotator__stage" data-tn-rotator-stage tabindex="0" role="region" aria-roledescription="carousel" aria-label="TravelNivo travel essentials">
      <div class="tn-rotator__track">
        {% assign item_count = 0 %}
        {% for handle in featured_handles %}
          {% assign product = all_products[handle] %}
          {% if product != blank %}
            {% assign item_index = item_count %}
            <article class="tn-rotator-card" data-tn-slide data-tn-index="{{ item_index }}" data-tn-title="{{ product.title | escape }}" data-tn-reveal role="group" aria-roledescription="slide" aria-label="{{ item_index | plus: 1 }} of {{ featured_handles.size }}">
              <a class="tn-rotator-card__image" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                {% if product.featured_image != blank %}
                  <img src="{{ product.featured_image | image_url: width: 1100 }}" alt="{{ product.title | escape }}" width="1100" height="1100" loading="{% if item_index == 0 %}eager{% else %}lazy{% endif %}" {% if item_index == 0 %}fetchpriority="high"{% endif %}>
                {% endif %}
              </a>
              <div class="tn-rotator-card__shade" aria-hidden="true"></div>
              <div class="tn-rotator-card__content">
                <div class="tn-rotator-card__eyebrow"><span>0{{ item_index | plus: 1 }}</span><small>Travel essential</small></div>
                <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
                <div class="tn-rotator-card__buy-row">
                  <strong>{{ product.price | money }}</strong>
                  {% if product.has_only_default_variant and product.selected_or_first_available_variant.available %}
                    <form action="{{ routes.cart_add_url }}" method="post" class="tn-rotator-card__form" data-tn-quick-add>
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      <button class="tn-rotator-card__buy" type="submit" data-tn-quick-add-button><span>Add to bag</span><span aria-hidden="true">+</span></button>
                    </form>
                  {% else %}
                    <a class="tn-rotator-card__buy tn-rotator-card__buy--options" href="{{ product.url }}">Choose options <span aria-hidden="true">→</span></a>
                  {% endif %}
                </div>
              </div>
            </article>
            {% assign item_count = item_count | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="tn-rotator__controls" data-tn-reveal style="--tn-delay: 120ms;">
      <button class="tn-rotator__arrow" type="button" data-tn-rotator-prev aria-label="Show previous product"><span aria-hidden="true">←</span></button>
      <div class="tn-rotator__dots" data-tn-rotator-dots role="tablist" aria-label="Choose a travel essential">
        {% assign dot_index = 0 %}
        {% for handle in featured_handles %}
          {% assign product = all_products[handle] %}
          {% if product != blank %}
            <button class="tn-rotator__dot" type="button" role="tab" data-tn-rotator-dot data-tn-index="{{ dot_index }}" aria-label="Show {{ product.title | escape }}" aria-selected="{% if dot_index == 0 %}true{% else %}false{% endif %}" tabindex="{% if dot_index == 0 %}0{% else %}-1{% endif %}"><span aria-hidden="true"></span></button>
            {% assign dot_index = dot_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
      <span class="tn-rotator__count" data-tn-rotator-count aria-live="polite">01 / {{ item_count | prepend: '0' }}</span>
      <button class="tn-rotator__arrow" type="button" data-tn-rotator-next aria-label="Show next product"><span aria-hidden="true">→</span></button>
    </div>
    <p class="tn-rotator__hint" data-tn-reveal style="--tn-delay: 180ms;">Swipe or use the arrows to turn the collection</p>
    <span class="tn-visually-hidden" data-tn-rotator-status aria-live="polite"></span>
  </div>
</section>

{% stylesheet %}
  .tn-featured { background: var(--tn-cream); color: var(--tn-ink); padding: clamp(70px, 9vw, 126px) 20px; }
  .tn-featured__inner { width: min(1240px, 100%); margin: 0 auto; }
  .tn-featured__header { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
  .tn-featured__eyebrow { margin: 0 0 10px; color: var(--tn-accent); font-size: .7rem; font-weight: 800; letter-spacing: .2em; }
  .tn-featured h2 { margin: 0; max-width: 760px; font-size: clamp(2.6rem, 5vw, 5.8rem); line-height: .92; letter-spacing: -.06em; }
  .tn-featured h2 em { color: var(--tn-accent); font-style: normal; }
  .tn-featured__subhead { max-width: 500px; margin: 18px 0 0; color: #52686a; font-size: 1rem; line-height: 1.55; }
  .tn-featured__view-all { display: inline-flex; align-items: center; gap: 8px; color: var(--tn-ink); font-weight: 700; white-space: nowrap; text-underline-offset: 5px; }
  .tn-featured__view-all span { transition: transform 160ms ease; }
  .tn-featured__view-all:hover span { transform: translate(2px,-2px); }
  .tn-rotator__stage { position: relative; min-height: 580px; margin: 0 -20px; overflow: hidden; border-radius: 30px 30px 30px 7px; background: radial-gradient(circle at 50% 18%, rgba(88,152,160,.2), transparent 42%), var(--tn-ink); perspective: 1400px; touch-action: pan-y; }
  .tn-rotator__stage:focus-visible { outline: 3px solid var(--tn-accent); outline-offset: 5px; }
  .tn-rotator__track { position: relative; width: 100%; height: 560px; transform-style: preserve-3d; }
  .tn-rotator-card { position: absolute; top: 20px; left: 50%; width: min(360px, 56vw); height: 520px; overflow: hidden; border-radius: 28px 28px 28px 7px; background: #e9efed; box-shadow: 0 24px 60px rgba(0,0,0,.34); backface-visibility: hidden; transform: translateX(-50%) scale(.62); opacity: 0; filter: saturate(.5) brightness(.5); pointer-events: none; transition: transform 620ms cubic-bezier(.2,.7,.2,1), opacity 480ms ease, filter 480ms ease, box-shadow 480ms ease; will-change: transform, opacity; }
  .tn-rotator-card[data-tn-position="active"] { z-index: 5; transform: translateX(-50%) scale(1) rotateY(0deg); opacity: 1; filter: none; pointer-events: auto; box-shadow: 0 30px 70px rgba(0,0,0,.44); }
  .tn-rotator-card[data-tn-position="prev"] { z-index: 4; transform: translateX(calc(-50% - min(31vw, 245px))) scale(.82) rotateY(19deg); opacity: .72; filter: saturate(.65) brightness(.66); pointer-events: auto; }
  .tn-rotator-card[data-tn-position="next"] { z-index: 4; transform: translateX(calc(-50% + min(31vw, 245px))) scale(.82) rotateY(-19deg); opacity: .72; filter: saturate(.65) brightness(.66); pointer-events: auto; }
  .tn-rotator-card[data-tn-position="far-left"] { z-index: 2; transform: translateX(calc(-50% - min(57vw, 485px))) scale(.66) rotateY(25deg); opacity: .3; filter: saturate(.35) brightness(.5); pointer-events: auto; }
  .tn-rotator-card[data-tn-position="far-right"] { z-index: 2; transform: translateX(calc(-50% + min(57vw, 485px))) scale(.66) rotateY(-25deg); opacity: .3; filter: saturate(.35) brightness(.5); pointer-events: auto; }
  .tn-rotator-card[data-tn-position="hidden"] { z-index: 0; transform: translateX(-50%) scale(.55); opacity: 0; pointer-events: none; }
  .tn-rotator-card__image { position: absolute; inset: 0; display: block; }
  .tn-rotator-card__image img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .tn-rotator-card__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 42%, rgba(18,28,29,.94) 100%); pointer-events: none; }
  .tn-rotator-card__content { position: absolute; right: 24px; bottom: 22px; left: 24px; color: var(--tn-cream); }
  .tn-rotator-card__eyebrow { display: flex; align-items: center; gap: 10px; color: var(--tn-accent); font-size: .64rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .tn-rotator-card__eyebrow span { color: var(--tn-sand); }
  .tn-rotator-card__eyebrow small { color: rgba(251,250,247,.72); font-size: inherit; }
  .tn-rotator-card h3 { margin: 9px 0 14px; font-size: clamp(1.25rem, 2vw, 1.7rem); line-height: 1.04; letter-spacing: -.03em; }
  .tn-rotator-card h3 a { color: inherit; text-decoration: none; }
  .tn-rotator-card h3 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .tn-rotator-card__buy-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .tn-rotator-card__buy-row strong { font-size: 1rem; white-space: nowrap; }
  .tn-rotator-card__form { margin: 0; }
  .tn-rotator-card__buy { display: inline-flex; min-height: 44px; align-items: center; justify-content: center; gap: 14px; padding: 0 14px; border: 1px solid var(--tn-accent); border-radius: 999px; background: var(--tn-accent); color: var(--tn-ink); cursor: pointer; font: inherit; font-size: .76rem; font-weight: 800; text-decoration: none; transition: transform 160ms ease, background-color 160ms ease, color 160ms ease; }
  .tn-rotator-card__buy:hover { background: var(--tn-cream); color: var(--tn-ink); transform: translateY(-2px); }
  .tn-rotator-card__buy--options { background: transparent; color: var(--tn-cream); }
  .tn-rotator-card__buy--options:hover { background: var(--tn-cream); }
  .tn-rotator-card:not([data-tn-position="active"]) .tn-rotator-card__buy-row { opacity: 0; transform: translateY(8px); transition: opacity 260ms ease, transform 260ms ease; }
  .tn-rotator-card[data-tn-position="active"] .tn-rotator-card__buy-row { opacity: 1; transform: none; }
  .tn-rotator__controls { display: flex; align-items: center; justify-content: center; gap: 18px; margin-top: 22px; }
  .tn-rotator__arrow { display: inline-grid; width: 46px; height: 46px; place-items: center; border: 1px solid rgba(47,56,56,.22); border-radius: 50%; background: transparent; color: var(--tn-ink); cursor: pointer; font: inherit; font-size: 1.1rem; transition: background-color 160ms ease, color 160ms ease, transform 160ms ease; }
  .tn-rotator__arrow:hover { background: var(--tn-ink); color: var(--tn-cream); transform: translateY(-1px); }
  .tn-rotator__dots { display: flex; align-items: center; gap: 4px; }
  .tn-rotator__dot { display: inline-grid; width: 44px; height: 44px; place-items: center; border: 0; background: transparent; cursor: pointer; }
  .tn-rotator__dot span { display: block; width: 7px; height: 7px; border-radius: 50%; background: #a9bbb9; transition: transform 180ms ease, background-color 180ms ease; }
  .tn-rotator__dot:hover span { background: var(--tn-accent); }
  .tn-rotator__dot[aria-selected="true"] span { background: var(--tn-accent); transform: scale(1.7); }
  .tn-rotator__count { min-width: 42px; color: #607577; font-size: .7rem; font-weight: 800; letter-spacing: .12em; }
  .tn-rotator__hint { margin: 8px 0 0; color: #607577; font-size: .74rem; text-align: center; }
  .tn-visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 760px) {
    .tn-featured { padding-inline: 14px; }
    .tn-featured__header { align-items: start; margin-bottom: 24px; }
    .tn-featured__header .tn-featured__view-all { margin-top: 5px; }
    .tn-featured__subhead { font-size: .92rem; }
    .tn-rotator__stage { min-height: 520px; margin-inline: -14px; border-radius: 24px 24px 24px 6px; }
    .tn-rotator__track { height: 500px; }
    .tn-rotator-card { top: 15px; width: min(78vw, 320px); height: 470px; }
    .tn-rotator-card[data-tn-position="prev"] { transform: translateX(calc(-50% - 33vw)) scale(.76) rotateY(17deg); opacity: .52; }
    .tn-rotator-card[data-tn-position="next"] { transform: translateX(calc(-50% + 33vw)) scale(.76) rotateY(-17deg); opacity: .52; }
    .tn-rotator-card[data-tn-position="far-left"], .tn-rotator-card[data-tn-position="far-right"] { opacity: 0; pointer-events: none; }
    .tn-rotator-card__content { right: 18px; bottom: 18px; left: 18px; }
    .tn-rotator-card__buy-row { align-items: end; }
    .tn-rotator__controls { gap: 8px; margin-top: 16px; }
    .tn-rotator__count { min-width: 36px; font-size: .64rem; }
    .tn-rotator__hint { font-size: .7rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tn-rotator-card, .tn-rotator-card__buy-row, .tn-rotator__dot span, .tn-rotator__arrow { transition: none; }
  }
{% endstylesheet %}

