<section class="tn-story" data-tn-section>
  <div class="tn-story__inner">
    <div class="tn-story__media" data-tn-reveal>
      <img src="https://cdn.shopify.com/s/files/1/0816/4609/2515/files/5c67bc44-07a7-4d2f-ab8e-b0e6a924a24e.jpg?v=1787745562" alt="TravelNivo travel packing organizers arranged for a trip" width="1200" height="1200" loading="lazy">
      <span class="tn-story__caption">TRAVELNIVO FIELD NOTE / 01</span>
    </div>
    <div class="tn-story__copy" data-tn-reveal style="--tn-delay: 120ms;">
      <p class="tn-story__eyebrow">WHY TRAVELNIVO / 04</p>
      <h2>Small organizers.<br><em>Smoother trips.</em></h2>
      <p>TravelNivo focuses on the small travel tools that make a real difference: less digging, less mess, and a clearer place for the things you bring with you.</p>
      <a class="tn-story__link" href="/collections/travel-essentials">Shop the collection <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

{% stylesheet %}
  .tn-story { background: #e8dcc8; color: #2f3838; padding: clamp(70px, 9vw, 126px) 20px; }
  .tn-story__inner { width: min(1240px, 100%); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); align-items: center; gap: clamp(34px, 8vw, 118px); }
  .tn-story__media { position: relative; overflow: hidden; border-radius: 30px 30px 30px 6px; background: #fff; }
  .tn-story__media img { display: block; width: 100%; aspect-ratio: 1 / .86; object-fit: cover; transition: transform 600ms cubic-bezier(.2,.7,.2,1); }
  .tn-story__media:hover img { transform: scale(1.035); }
  .tn-story__caption { position: absolute; left: 18px; bottom: 18px; padding: 8px 10px; border-radius: 999px; background: rgba(251,250,247,.9); color: #2f3838; font-size: .62rem; font-weight: 800; letter-spacing: .1em; }
  .tn-story__eyebrow { margin: 0 0 14px; color: #5898a0; font-size: .7rem; font-weight: 800; letter-spacing: .18em; }
  .tn-story h2 { margin: 0; font-size: clamp(2.8rem, 5.4vw, 6rem); line-height: .9; letter-spacing: -.065em; }
  .tn-story h2 em { color: #5898a0; font-style: normal; }
  .tn-story__copy > p:not(.tn-story__eyebrow) { max-width: 520px; margin: 28px 0 0; color: #52686a; font-size: 1.02rem; line-height: 1.7; }
  .tn-story__link { display: inline-flex; gap: 11px; align-items: center; margin-top: 28px; color: #2f3838; font-weight: 800; text-underline-offset: 5px; }
  .tn-story__link span { transition: transform 160ms ease; }
  .tn-story__link:hover span { transform: translateX(4px); }
  @media (max-width: 760px) { .tn-story { padding-inline: 14px; } .tn-story__inner { grid-template-columns: 1fr; } }
{% endstylesheet %}

